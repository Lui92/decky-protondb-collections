  },
  "peerDependencies": {
    "@decky/plugin": "^1.1.3 || ^1.1.x || ^4.x",
    "@decky/ui": "^1.1.3 || ^1.1.x || ^4.x"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^18.0.0",
    "@types/node-fetch": "^2.6.4",
    "archiver": "^5.3.1",
    "esbuild": "^0.18.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  }
