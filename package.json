{
  "name": "decky-protondb-collections",
  "version": "0.1.0",
  "description": "Decky plugin: generate Steam collections from ProtonDB badges",
  "main": "dist/index.js",
  "packageManager": "pnpm@9",
  "engines": {
    "node": ">=16.14",
    "pnpm": "9"
  },
  "scripts": {
    "setup": "pnpm install",
    "build": "node ./scripts/build.js",
    "watch": "node ./scripts/build.js --watch",
    "lint": "echo TODO: add linter",
    "test": "jest --config ./jest.config.js",
    "package": "node ./scripts/package.js",
    "start-bridge": "node ./scripts/expressBridge.js"
  },
  "author": "Lui92",
  "license": "MIT",
  "dependencies": {
    "@decky/api": "^1.1.3",
    "@decky/ui": "^4.11.1",
    "body-parser": "^2.2.2",
    "eventemitter3": "^4.0.7",
    "express": "^5.2.1",
    "node-fetch": "^2.6.7"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^18.0.0",
    "@types/node-fetch": "^2.6.4",
    "@decky/rollup": "^1.0.2",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "archiver": "^5.3.1",
    "esbuild": "^0.18.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0",
    "rollup": "^4.53.3"
  },
   "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
